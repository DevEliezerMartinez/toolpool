# ID del proyecto de Microsoft Clarity (clarity.microsoft.com > Settings > Setup)
# Copia este archivo como .env y pon el ID real. Clarity solo se carga en producción y después
# de que la persona acepta las cookies en el aviso (src/components/layout/CookieBanner.astro).
# Sin ID, el aviso de cookies no se muestra en producción.
PUBLIC_CLARITY_ID=

# URL del Apps Script que guarda el formulario en Google Sheets (ver google-apps-script/README.md)
PUBLIC_FORM_ENDPOINT=
