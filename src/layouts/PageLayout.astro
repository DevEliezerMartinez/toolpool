---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
  /** overlay: transparente sobre el hero. solid: barra navy para páginas internas. */
  headerVariant?: 'overlay' | 'solid';
}

const { title, description, headerVariant = 'solid' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header variant={headerVariant} />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
