---
/**
 * Sección con el formulario de contacto. El texto de la columna izquierda va en el slot,
 * escrito en cada página. Solo debe haber una por página (usa id="formulario").
 */
import Container from '../ui/Container.astro';
import ContactForm from '../ui/ContactForm.astro';

interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow = 'Contacto', title } = Astro.props;
---

<section id="formulario" class="bg-white py-14 sm:py-20">
  <Container class="grid gap-10 lg:grid-cols-[1fr_1.2fr]">
    <div data-animate="fade-up">
      <p class="mb-4 flex items-center gap-4 text-sm tracking-wide font-display uppercase italic">
        <span class="h-px w-14 bg-navy" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h2 class="text-2xl font-semibold text-balance text-brand sm:text-3xl">{title}</h2>
      <div class="mt-4 space-y-4 text-navy/80 [&_a]:font-semibold [&_a]:text-brand-dark [&_a:hover]:underline">
        <slot />
      </div>
    </div>

    <div class="rounded-md bg-sky-soft p-6 sm:p-8" data-animate="fade-up">
      <ContactForm />
    </div>
  </Container>
</section>
