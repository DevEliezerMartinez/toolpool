---
import Container from './Container.astro';
import { waterTexture } from '../../lib/gallery';

interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;

// Agua que se ve dentro del título (.water-text en global.css)
const water = waterTexture();
---

<section class="bg-sky-soft py-14 sm:py-20">
  <Container>
    <p class="mb-4 flex items-center gap-4 text-sm tracking-wide text-navy font-display uppercase italic">
      <span class="h-px w-14 bg-navy" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1
      class="water-text water-text-title max-w-3xl text-3xl font-bold text-balance text-brand sm:text-5xl"
      style={`--water: ${water}`}
    >
      {title}
    </h1>
    <div class="mt-5 max-w-2xl text-base text-navy/80 sm:text-lg">
      <slot />
    </div>
  </Container>
</section>
