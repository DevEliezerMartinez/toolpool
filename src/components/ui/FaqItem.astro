---
import { Icon } from 'astro-icon/components';
interface Props {
  question: string;
  /** Las preguntas con el mismo name forman un grupo donde solo una queda abierta a la vez */
  name?: string;
}

const { question, name } = Astro.props;
---

<details name={name} class="group border-b border-slate-200">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold [&::-webkit-details-marker]:hidden">
    {question}
    <Icon aria-hidden="true" name="lucide:plus" class="size-5 shrink-0 text-brand transition group-open:rotate-45" />
  </summary>
  <div class="pb-5 text-sm text-navy/80 [&_a]:font-semibold [&_a]:text-brand-dark [&_a:hover]:underline">
    <slot />
  </div>
</details>
