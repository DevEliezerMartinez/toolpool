---
import { Icon } from 'astro-icon/components';
/**
 * Formulario de contacto. Cada envío se guarda en la hoja "Solicitudes" del CRM en Google Sheets
 * (ver google-apps-script/README.md).
 * La hoja recibe: Folio · Fecha y hora · Nombre · WhatsApp · Tipo · Producto · Mensaje · Página de origen · Estatus.
 * Folio, fecha y estatus los genera el script de Google; la página de origen la calcula este componente.
 *
 * Para preseleccionar el tipo desde un enlace: <a href="#formulario" data-form-tipo="Mantenimiento">
 * (opcionalmente data-form-producto="..."), o desde otra página con /contacto?tipo=Producto
 */
import { whatsappUrl } from '../../lib/whatsapp';

const fieldClass =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm text-navy outline-none focus:border-brand focus:ring-2 focus:ring-brand/30';
---

<form class="grid gap-4 sm:grid-cols-2" data-contact-form novalidate>
  <label class="block text-sm font-medium">
    Nombre
    <input type="text" name="nombre" required autocomplete="name" maxlength="80" class={fieldClass} />
  </label>

  <label class="block text-sm font-medium">
    WhatsApp
    <input
      type="tel"
      name="whatsapp"
      required
      autocomplete="tel-national"
      inputmode="numeric"
      maxlength="20"
      placeholder="10 dígitos"
      class={fieldClass}
    />
  </label>

  <label class="block text-sm font-medium sm:col-span-2">
    ¿En qué te ayudamos?
    <select name="tipo" required class={fieldClass}>
      <option value="">Elige una opción</option>
      <option>Mantenimiento</option>
      <option>Construcción</option>
      <option>Rehabilitación</option>
      <option>Equipamiento y área de máquinas</option>
      <option>Tratamiento del agua</option>
      <option>Asesoría especializada</option>
      <option>Producto</option>
    </select>
  </label>

  {/* Combobox: se puede elegir una sugerencia o escribir otro producto. Para sumar productos, agrega un <option>. */}
  <label class="block text-sm font-medium sm:col-span-2" data-producto-field hidden>
    Producto
    <input
      type="text"
      name="producto"
      list="productos-sugeridos"
      maxlength="120"
      placeholder="Elige o escribe el producto"
      class={fieldClass}
    />
    <datalist id="productos-sugeridos">
      <option value="Kit de empaques"></option>
      <option value="Timer mecánico"></option>
      <option value="Sellador Pool Putty"></option>
      <option value="Kit analizador de cloro y pH"></option>
    </datalist>
  </label>

  <label class="block text-sm font-medium sm:col-span-2">
    Mensaje <span class="font-normal text-navy/60">(opcional)</span>
    <textarea name="mensaje" rows="4" maxlength="1000" class={fieldClass}></textarea>
  </label>

  {/* Campo trampa contra spam: las personas no lo ven; si llega lleno, el envío se descarta */}
  <div class="hidden" aria-hidden="true">
    <label>Empresa <input type="text" name="empresa" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="sm:col-span-2">
    <button
      type="submit"
      class="inline-flex items-center justify-center bg-amber px-6 py-3 text-sm font-medium text-navy transition hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-60"
    >
      Enviar mis datos
    </button>
    <p class="mt-3 text-xs text-navy/60">
      Usamos tus datos solo para contactarte. Consulta nuestro
      <a href="/aviso-de-privacidad" class="underline hover:text-navy">aviso de privacidad</a>.
    </p>
  </div>

  <p class="hidden rounded-md p-4 text-sm sm:col-span-2" role="status" aria-live="polite" data-form-status></p>

  {/* Respaldo si el envío falla */}
  <p class="hidden text-sm sm:col-span-2" data-form-fallback>
    <a
      href={whatsappUrl('Hola, tengo una pregunta.')}
      target="_blank"
      rel="noopener"
      class="font-semibold text-brand-dark hover:underline">Escríbenos por WhatsApp <Icon aria-hidden="true" name="lucide:arrow-right" class="inline-block size-[1em] align-[-0.125em]" /></a
    >
  </p>
</form>

<script>
  const ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const tipo = form.elements.namedItem('tipo') as HTMLSelectElement;
    const producto = form.elements.namedItem('producto') as HTMLInputElement;
    const whatsapp = form.elements.namedItem('whatsapp') as HTMLInputElement;
    const productoField = form.querySelector<HTMLElement>('[data-producto-field]')!;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const fallback = form.querySelector<HTMLElement>('[data-form-fallback]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const syncProducto = () => {
      const show = tipo.value === 'Producto';
      productoField.hidden = !show;
      if (!show) producto.value = '';
    };

    const preselect = (tipoValue: string | null, productoValue?: string | null) => {
      if (!tipoValue) return;
      const option = [...tipo.options].find((o) => o.value.toLowerCase() === tipoValue.toLowerCase());
      if (!option) return;
      tipo.value = option.value;
      syncProducto();
      if (productoValue && tipo.value === 'Producto') producto.value = productoValue;
    };

    const showStatus = (kind: 'info' | 'ok' | 'error', text: string) => {
      status.textContent = text;
      status.className =
        'rounded-md p-4 text-sm sm:col-span-2 ' +
        { info: 'bg-sky-soft text-navy', ok: 'bg-green-50 text-green-900', error: 'bg-red-50 text-red-900' }[kind];
      fallback.classList.toggle('hidden', kind !== 'error');
    };

    tipo.addEventListener('change', syncProducto);

    // Enlaces de la página que llevan al formulario con el tipo ya elegido
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLElement>('[data-form-tipo]');
      if (link) preselect(link.dataset.formTipo ?? null, link.dataset.formProducto);
    });

    // Llegada desde otra página: /contacto?tipo=Producto&producto=...
    const params = new URLSearchParams(location.search);
    preselect(params.get('tipo'), params.get('producto'));

    whatsapp.addEventListener('input', () => whatsapp.setCustomValidity(''));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const digits = whatsapp.value.replace(/\D/g, '');
      whatsapp.setCustomValidity(digits.length === 10 ? '' : 'Escribe tu WhatsApp a 10 dígitos.');
      if (!form.reportValidity()) return;

      if (!ENDPOINT) {
        showStatus('error', 'El formulario aún no está conectado. Mientras tanto, escríbenos por WhatsApp.');
        return;
      }

      const data = new FormData(form);
      const payload = {
        nombre: String(data.get('nombre')).trim(),
        whatsapp: digits,
        tipo: tipo.value,
        producto: String(data.get('producto') ?? '').trim(),
        mensaje: String(data.get('mensaje') ?? '').trim(),
        pagina: location.pathname + '#formulario',
        empresa: String(data.get('empresa') ?? ''),
      };

      submit.disabled = true;
      showStatus('info', 'Enviando…');

      try {
        // text/plain evita la verificación previa (preflight) que Apps Script no responde
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!result.ok) throw new Error(result.error ?? 'Respuesta inválida');

        form.reset();
        syncProducto();
        showStatus(
          'ok',
          result.folio
            ? `Recibimos tus datos. Tu folio es ${result.folio}; te contactamos pronto por WhatsApp.`
            : 'Recibimos tus datos; te contactamos pronto por WhatsApp.',
        );
        (window as any).clarity?.('event', 'envio_formulario');
      } catch {
        showStatus('error', 'No pudimos enviar tus datos. Inténtalo de nuevo o escríbenos por WhatsApp.');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
