---
/**
 * Bloque imagen + texto de la página de servicios.
 * El contenido (párrafos, lista, enlace) se escribe en la página vía slot.
 */
import Container from './Container.astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  number: string;
  title: string;
  tagline: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Pone la imagen a la derecha en desktop */
  reverse?: boolean;
}

const { id, number, title, tagline, image, imageAlt, reverse = false } = Astro.props;
---

<section id={id} class="py-12 sm:py-16">
  <Container class="grid items-center gap-10 lg:grid-cols-2">
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 640, 960]}
      sizes="(min-width: 1024px) 45vw, 100vw"
      class:list={['aspect-[4/3] w-full rounded-md object-cover', reverse && 'lg:order-last']}
      data-animate="fade-up"
    />
    <div data-animate="fade-up">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-sky-soft text-xs font-semibold text-brand-dark"
        >{number}</span
      >
      <h2 class="mt-4 text-2xl font-semibold text-brand sm:text-3xl">{title}</h2>
      <p class="mt-1 font-display text-lg italic">{tagline}</p>
      <div class="mt-4 space-y-4 text-navy/80 [&_a]:font-semibold [&_a]:text-brand-dark [&_a:hover]:underline [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 [&_ul]:text-sm">
        <slot />
      </div>
      {/* Baja al formulario de la página con este servicio ya elegido */}
      <a
        href="#formulario"
        data-form-tipo={title}
        class="mt-3 inline-block text-sm text-navy/70 underline hover:text-navy">Prefiero que me contacten</a
      >
    </div>
  </Container>
</section>
